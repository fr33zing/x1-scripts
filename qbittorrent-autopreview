def notify(text):
    with open(LOG_FILE, "a") as file:
        file.write(text)

    body = shlex.quote(f'<b><a href="file://{LOG_FILE}">View log</a></b>\n\n{text}')
    os.system(f"notify-send -u critical '{SCRIPT_NAME}' {body}")


def api(fn, params, method="GET") -> Result[Any]:
    parts = [API_ENDPOINT, fn]
    if method == "GET":
        parts.append("?")
        for k, v in params.items():
            parts.append(f"{k}={v}")
    url = "".join(parts)

    try:

        def send_req():
            if method == "GET":
                return request.urlopen(url)
            elif method == "POST":
                body = parse.urlencode(params).encode()
                req = request.Request(url, data=body, method=method)
                return request.urlopen(req)

        with send_req() as res:
            text = res.read().decode()
            if not text and res.status == 200:
                return Ok(None)
            data = json.loads(text)
            return Ok(data)
    except Exception as e:
        if DEBUG_WEBUI_CALLS:
            raise Exception(f"Request failed ({url})") from e
        return Err(Error.WebUiError)


def get_torrent_eta() -> Result[int]:
    return api("properties", {"hash": TORRENT_ID}).map(lambda data: data["eta"])


def get_torrent_seq_dl_and_f_l_piece_prio() -> Result[tuple[bool, bool]]:
    return api("info", {"hashes": TORRENT_ID}).map(
        lambda data: (data[0]["seq_dl"], data[0]["f_l_piece_prio"])
    )


def toggle_torrent_seq_dl() -> Result[None]:
    return api("toggleSequentialDownload", {"hashes": TORRENT_ID}, "POST").map(
        lambda _: None
    )


def toggle_torrent_f_l_piece_prio() -> Result[None]:
    return api("toggleFirstLastPiecePrio", {"hashes": TORRENT_ID}, "POST").map(
        lambda _: None
    )


def get_torrent_video_list() -> Result[List[str]]:
    return api("files", {"hash": TORRENT_ID}).map(
        lambda files: list(
            map(
                lambda file: str(file["name"]),
                filter(
                    lambda file: file["priority"] != 0
                    and is_streamable_video_file(file["name"], True),
                    files,
                ),
            )
        )
    )


def get_video_duration(path) -> Result[int]:
    try:
        result = subprocess.run(
            [
                "ffprobe",
                "-v",
                "quiet",
                "-show_entries",
                "format=duration",
                "-of",
                "default=noprint_wrappers=1:nokey=1",
                path,
            ],
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
        )
        output = result.stdout.splitlines()[-1]
        duration = int(float(output))

        return Ok(duration)
    except:
        return Err(Error.NoVideoDuration)


def is_streamable_video_file(path, allow_nonexistent=False):
    if os.path.isdir(path):
        return False
    if len(path) < 5:
        return False
    path_end = path[5:]
    for ext in STREAMING_CONTAINER_FORMATS:
        if path_end.endswith(ext):
            return True
    return False


def find_all_video_paths():
    video_paths = []

    def check_files_recursive(path):
        for entry in os.listdir(path):
            full_path = os.path.join(path, entry)
            if os.path.isdir(full_path):
                check_files_recursive(full_path)
            elif is_streamable_video_file(full_path):
                video_paths.append(full_path)

    if is_streamable_video_file(SAVE_PATH):
        return [SAVE_PATH]
    elif os.path.isdir(SAVE_PATH):
        check_files_recursive(SAVE_PATH)
    return video_paths


def get_video_path() -> Result[str]:
    all_video_paths = find_all_video_paths()
    match len(all_video_paths):
        case 0:
            return Err(Error.NoVideosInFilesystem)
        case 1:
            return Ok(all_video_paths[0])
        case _:
            return Err(Error.TooManyVideosInFilesystem)


def is_valid_video_file(path):
    player = vlc.MediaPlayer(f"file://{path}")
    code = player.play()
    player.stop()
    player.release()
    return code == 0


def nuclear_suicide():
    # Nothing else works anymore...
    # Probably would need to run the vlc checking stuff in a fork
    pid = os.getpid()
    os.system(f"kill -9 {pid}")


def pretty_time_delta(seconds):
    sign_string = "-" if seconds < 0 else ""
    seconds = abs(int(seconds))
    days, seconds = divmod(seconds, 86400)
    hours, seconds = divmod(seconds, 3600)
    minutes, seconds = divmod(seconds, 60)
    if days > 0:
        return "%s%dd %dh %dm %ds" % (sign_string, days, hours, minutes, seconds)
    elif hours > 0:
        return "%s%dh %dm %ds" % (sign_string, hours, minutes, seconds)
    elif minutes > 0:
        return "%s%dm %ds" % (sign_string, minutes, seconds)
    else:
        return "%s%ds" % (sign_string, seconds)


