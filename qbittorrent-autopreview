SCRIPT_NAME = "qbittorrent-autopreview"
LOG_FILE = f"/tmp/{SCRIPT_NAME}.log"
DEBUG_WEBUI_CALLS = True

NAME = sys.argv[1]  # %N
SAVE_PATH = sys.argv[2]  # %D
TORRENT_ID = sys.argv[3]  # %K

API_ADDR = "127.0.0.1"
API_PORT = "8080"
API_ENDPOINT = f"http://{API_ADDR}:{API_PORT}/api/v2/torrents/"

COUNTDOWN_SECS = 30
INTERVAL = 1000
STREAMING_CONTAINER_FORMATS = [
    ".mkv",
    ".mk3d",
    ".mov",
    ".qt",
    ".asf",
    ".wmv",
    ".mxf",
    ".ts",
    ".tsv",
    ".3gp",
    ".3g2",
    ".f4v",
    ".ogv",
    ".ogx",
    ".webm",
    ".rmvb",
    ".divx",
]


class Status(Enum):
    Waiting = (False, False)
    Fatal = (False, True)
    Ready = (True, True)

    def __init__(self, should_exit, should_play):
        self.should_exit = should_exit
        self.should_play = should_play


class Error(Enum):
    NoVideosInTorrent = ("No streamable video files in torrent!", Status.Fatal)
    TooManyVideosInTorrent = ("Too many video files!", Status.Fatal)
    NoVideosInFilesystem = ("Waiting for video files...", Status.Waiting)
    TooManyVideosInFilesystem = ("Too many video files!", Status.Fatal)
    NoVideoDuration = ("Waiting to determine video duration...", Status.Waiting)
    WebUiError = ("Web UI unreachable!", Status.Fatal)
    VideoUnplayable = ("Waiting for video to become playable...", Status.Waiting)
    Buffering = ("Buffering for about %s...", Status.Waiting)
    Countdown = ("Starting in %s...", Status.Waiting)

    def __init__(self, message, status):
        self.message = message
        self.status = status


T = TypeVar("T")
Y = TypeVar("Y")


class Result(Generic[T]):
    value: Optional[T] = None
    error: Optional[Error] = None

    def __init__(self, value: Optional[T], error: Optional[Error]):
        self.value = value
        self.error = error

    def is_ok(self) -> bool:
        return bool(self.value and not self.error)

    def map(self, fn: Callable[[T], Y]) -> Result[Y]:
        if self.value:
            return Ok(fn(self.value))
        return Err(self.error)


def Ok(value):
    return Result(value, None)


def Err(error):
    return Result(None, error)


class State:
    status: Status = Status.Waiting
    error: Optional[Error] = None
    video_path: Optional[str] = None
    video_duration: Optional[int] = None
    torrent_eta: Optional[int] = None
    video_playable: bool = False
    autopreview_eta: Optional[int] = None

    countdown_start: Optional[int] = None
    countdown: bool = False

    torrent_seq_dl: Optional[bool] = None
    torrent_f_l_piece_prio: Optional[bool] = None

    def ready(self):
        self.error = None
        self.status = Status.Ready


#
# Entry point
#


def on_activate(app):
    # Main window
    window = Gtk.Window(application=app)
    window.set_default_size(100, 50)

    LayerShell.init_for_window(window)
    LayerShell.set_layer(window, LayerShell.Layer.TOP)
    LayerShell.set_anchor(window, LayerShell.Edge.TOP, True)
    LayerShell.set_margin(window, LayerShell.Edge.BOTTOM, 12)
    LayerShell.auto_exclusive_zone_enable(window)

    title = f"Downloading torrent:\n{NAME}\n"
    label = Gtk.Label(label=f"{title}\nInitializing...")
    label.set_margin_top(20)
    label.set_margin_bottom(20)
    label.set_margin_start(20)
    label.set_margin_end(20)
    window.set_child(label)
    window.present()

    state = State()

    def update_state(new_state):
        state = new_state
        lines = [title]

        if state.error:
            lines.append(state.error.message)

            if state.status == Status.Fatal:
                lines.append("\nFATAL!")
                msg = "\n".join(lines)
                notify(msg)
                nuclear_suicide()
            else:

                def add_countdown_to_last_line(countdown):
                    line = lines.pop()
                    line = line.replace("%s", pretty_time_delta(countdown))
                    lines.append(line)

                if state.error == Error.Buffering:
                    add_countdown_to_last_line(state.autopreview_eta + COUNTDOWN_SECS)
                elif state.error == Error.Countdown:
                    add_countdown_to_last_line(
                        COUNTDOWN_SECS - (time.time() - state.countdown_start)
                    )
        elif state.ready:
            lines.append("READY!")
            finish(state.video_path)

        label.set_label("\n".join(lines))

    GLib.timeout_add(INTERVAL, update, state, update_state)


def update(state, set_state):
    def _ensure_torrent_has_one_video():
        torrent_video_list = get_torrent_video_list()
        if torrent_video_list.is_ok():
            match len(torrent_video_list.value):
                case 0:
                    state.error = Error.NoVideosInTorrent
                case 1:
                    relative_path = torrent_video_list.value[0]
                    state.video_path = os.path.join(SAVE_PATH, relative_path)
                case _:
                    state.error = Error.TooManyVideosInTorrent
        else:
            state.error = torrent_video_list.error

    def _ensure_torrent_seq_dl_and_f_l_piece_prio():
        info = get_torrent_seq_dl_and_f_l_piece_prio()
        if info.is_ok():
            (seq_dl, f_l_piece_prio) = info.value
            if not seq_dl:
                result = toggle_torrent_seq_dl()
                if not result.is_ok():
                    state.error = result.error
                    return
            if not f_l_piece_prio:
                result = toggle_torrent_f_l_piece_prio()
                if not result.is_ok():
                    state.error = result.error
                    return

        else:
            state.error = info.error

    def _get_video_duration():
        if state.video_path and not state.video_duration:
            video_duration = get_video_duration(state.video_path)
            if video_duration.is_ok():
                state.video_duration = video_duration.value
            else:
                state.error = video_duration.error

    def _check_video_is_playable():
        if state.video_duration and not state.video_playable:
            if is_valid_video_file(state.video_path):
                state.video_playable = True
            else:
                state.error = Error.VideoUnplayable

    def _get_torrent_eta():
        if state.video_playable:
            torrent_eta = get_torrent_eta()
            if torrent_eta.is_ok():
                state.torrent_eta = torrent_eta.value
            else:
                state.error = torrent_eta.error

    def _calculate_autopreview_eta():
        if state.torrent_eta:
            state.autopreview_eta = state.torrent_eta - state.video_duration

            should_countdown = state.autopreview_eta <= 0

            if should_countdown != state.countdown:
                state.countdown = should_countdown
                state.countdown_start = time.time()

            if should_countdown:
                countdown_finished = (
                    time.time() - state.countdown_start > COUNTDOWN_SECS
                )
                if countdown_finished:
                    state.ready()
                else:
                    state.error = Error.Countdown
            else:
                state.error = Error.Buffering

    # Run steps in sequence
    try:
        steps = [
            _ensure_torrent_has_one_video,
            _ensure_torrent_seq_dl_and_f_l_piece_prio,
            _get_video_duration,
            _check_video_is_playable,
            _get_torrent_eta,
            _calculate_autopreview_eta,
        ]
        state.error = None
        for step in steps:
            step()
            if state.error:
                if state.error.status == Status.Fatal:
                    notify(f"FATAL ERROR:\n\n{state.error.message}")
                break
        set_state(state)
    except:
        e = traceback.format_exc()
        notify(f"EXCEPTION:\n\n{e}")
        nuclear_suicide()
    return True


def finish(path):
    os.system("~/scripts/tv_alert")
    subprocess.Popen(
        ["vlc", path],
        stdin=None,
        stdout=None,
        stderr=None,
    )
    nuclear_suicide()


