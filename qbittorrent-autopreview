def main():
    if os.path.exists(LOG_FILE):
        os.remove(LOG_FILE)

    app = Gtk.Application(application_id="com.github.fr33zing.qbittorrent_autopreview")
    app.connect("activate", on_activate)
    app.run(None)


if __name__ == "__main__":
    main()
